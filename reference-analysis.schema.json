{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference-analysis.schema.json",
  "type": "object",
  "required": ["schemaVersion", "source", "status", "evidence", "outputs"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "source": {
      "type": "object",
      "required": ["file", "durationSec", "width", "height", "fps"],
      "properties": {
        "file": { "type": "string" },
        "durationSec": { "type": "number", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "sha256": { "type": "string" },
        "audioStreams": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "status": { "type": "string", "enum": ["draft", "review-ready", "reviewed"] },
    "evidence": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["referenceOverview", "semanticTimeline", "motionCards"],
      "properties": {
        "referenceOverview": { "type": "string" },
        "semanticTimeline": { "type": "string" },
        "motionCards": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
