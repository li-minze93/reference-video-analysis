{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion-card.schema.json",
  "type": "object",
  "required": ["id", "name", "kind", "status", "evidence", "behavior", "adaptation", "confidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+){1,3}$" },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["page", "overlay", "transition", "caption", "sound", "scene"] },
    "status": { "type": "string", "const": "candidate" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceRange", "basis"],
        "properties": {
          "sourceRange": { "type": "string" },
          "basis": { "type": "string", "enum": ["observed", "measured", "interpreted", "unknown", "unverified"] },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "trigger": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["phrase", "word", "cue", "action", "clock", "range", "unknown"] },
        "text": { "type": "string" },
        "sourceRange": { "type": "string" },
        "status": { "type": "string", "enum": ["observed", "measured", "interpreted", "unknown", "unverified"] }
      },
      "additionalProperties": false
    },
    "behavior": {
      "type": "object",
      "required": ["initial", "entry", "hold", "change", "exit"],
      "properties": {
        "initial": { "type": "string" },
        "entry": { "type": "string" },
        "hold": { "type": "string" },
        "change": { "type": "string" },
        "exit": { "type": "string" },
        "hierarchy": { "type": "string" },
        "parameters": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "componentSuggestion": { "type": "string" },
    "audio": {
      "type": "object",
      "required": ["status", "cue"],
      "properties": {
        "status": { "type": "string", "enum": ["confirmed", "unverified", "unverified-mixed-track", "not-applicable"] },
        "cue": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "adaptation": { "type": "string" },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
